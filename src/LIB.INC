;------------------------------------------------------------------------------
; ScrollTile: scroll the tile at DX+BX down one pixel line, the bottom line coming back at the top
; (water, lava, force field, moon gate). In: DX = graphics base, BX = tile * 64. Saves all.
;------------------------------------------------------------------------------
ScrollTile:	pushf	;@463A
	push ax	;@463B
	push bx	;@463C
	push cx	;@463D
	push dx	;@463E
	add bx, dx	; BX = the tile	;@463F
	mov ax, word ptr [bx+3Ch]	; AX:DX = line 15 (the last odd line)	;@4641
	mov dx, word ptr [bx+3Eh]	;@4644
	mov cx, 8	;@4647
ScrollTile_Loop:	xchg word ptr [bx], ax	; even line 2i gets the line above (odd 2i-1)	;@464A
	xchg word ptr [bx+20h], ax	; odd line 2i+1 gets even line 2i	;@464C
	xchg word ptr [bx+2], dx	;@464F
	xchg word ptr [bx+22h], dx	;@4652
	add bx, 4	;@4655
	loop ScrollTile_Loop	;@4658
	pop dx	;@465A
	pop cx	;@465B
	pop bx	;@465C
	pop ax	;@465D
	popf	;@465E
	ret	;@465F
;------------------------------------------------------------------------------
; AnimScroll: scroll the animated terrain tiles, each on its own count: water (tile 0) every 3rd
