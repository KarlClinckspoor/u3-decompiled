; LIB.INC: the library linked into all three Ultima III programs (screen, text, keyboard,
; files, sound). Generated by tools/genlib.py from the three copies; each program's LIB.ASM
; defines PROG_ULTIMA, PROG_BOOTUP or PROG_EXODUS and includes this. Kxxxx = offset from the
; library start in BOOTUP.BIN; Xxxxx = a symbol of the program (value in BOOTUP.BIN).
;
; Overview. The library every program links: text output on the CGA screen, the keyboard,
; DOS file loading and saving, the random number generator, the PC speaker sounds and the
; tile drawing and animation of the map window.
; - Data: StackArea (the programs' stack), the text cursor CursorCol/CursorRow, the wind
;   (WindDir, WindCount), RandState (16 bytes, seeded by ULTIMA's and EXODUS's start-up from the
;   DOS date and time), the animation counters, the wind and file messages, TileGfx
;   (SHAPES.ULT, 80 tiles), CharGfx (CHARSET.ULT, 128 characters), ScreenSeg (B800h).
; - Text (40 x 25 cells of 8 x 8 pixels, no scrolling here): PutChar, DrawChar, PrintStr,
;   PrintStrLen, PrintAt, SwapCursor, PrintBcdWord, PrintBcdByte, PrintDigit.
; - Graphics (CGA mode 4, even scan lines at 0000, odd at 2000h): DrawTileBlock (16 x 16 tiles),
;   DrawView (the 11 x 11 map window), ViewTileAt, FillCell, ClearScreen.
; - Animation, run from KeyReady by Animate on every key poll: WindUpdate, AnimScroll (water,
;   lava, force field, moon gate scroll), AnimFlags (flags), SwapFrames (second frames of the figures),
;   BlinkPlayer (the combat member whose turn it is).
; - Keyboard: KeyReady, ReadKey, ReadLine, ReadNumber, ParseNumber, AskChoice (menu choice).
; - Files (DOS FCB calls, the FCB at PSP:5Ch, one record of CX bytes): LoadFile, SaveFile
;   (save), OpenFile ("Wrong Diskette!" until the file opens).
; - Random (DL = random below DH), SignStep, Sound (codes 0F4h-0FFh through SoundTbl).
; - DiskCheckStub: the patched-out copy protection (IFDEF PROG_EXODUS: the copies differ).
; The program symbols: CombatPlayer the combat member whose turn it is (0-3), CombatPartyX/CombatPartyY/CombatUnderTile/
; CombatPartyTile the combat party's x, y, tile underneath and own tile, Location the party's location
; (0 Sosaria, 1 dungeon, 4 shrine, 80h combat, 0FFh Ambrosia; ULTIMA keeps 1 there so that
; KeyReady animates nothing), ViewTiles the 11 x 11 view buffer.
CODE SEGMENT PARA PUBLIC
ASSUME CS:CODE, DS:CODE, ES:CODE, SS:CODE
EXTRN CombatPlayer:BYTE
EXTRN ViewTiles:BYTE
EXTRN CombatPartyX:BYTE
EXTRN CombatPartyY:BYTE
EXTRN CombatUnderTile:BYTE
EXTRN CombatPartyTile:BYTE
EXTRN Location:BYTE
PUBLIC StackArea
PUBLIC CursorCol
PUBLIC CursorRow
PUBLIC WindDir
PUBLIC RandState
PUBLIC RandMonthDay
PUBLIC RandHourMin
PUBLIC RandSecHund
PUBLIC RandYear2
PUBLIC RandMonthDay2
PUBLIC RandHourMin2
PUBLIC RandSecHund2
PUBLIC BlinkCount
PUBLIC TileGfx
PUBLIC CharGfx
PUBLIC ScreenSeg
PUBLIC PrintStr
PUBLIC SwapCursor
PUBLIC PutChar
PUBLIC DrawChar
PUBLIC DiskCheckStub
PUBLIC FillCell
PUBLIC DrawTileBlock
PUBLIC ClearScreen
PUBLIC ReadLine
PUBLIC Random
PUBLIC AnimScroll
PUBLIC AnimFlags
PUBLIC SwapFrames
PUBLIC KeyReady
PUBLIC ReadKey
PUBLIC PrintBcdWord
PUBLIC PrintBcdByte
PUBLIC PrintDigit
PUBLIC ParseNumber
PUBLIC AskChoice
PUBLIC ReadNumber
PUBLIC SaveFile
PUBLIC LoadFile
PUBLIC PrintAt
PUBLIC SignStep
PUBLIC DrawView
PUBLIC ViewTileAt
PUBLIC WindUpdate
PUBLIC SoundOn
PUBLIC Sound
; StackArea: 256 bytes; every program sets SP to their top (lea sp, StackArea / add sp, 100h).
StackArea label byte
	db 256 dup (0)	;@1E40
; The text cursor, also used as one word (DL = column 0-27h, DH = row 0-18h).
CursorCol label byte
	db 0h	;@1F40
CursorRow label byte
	db 0h	;@1F41
; WindDir: 0 calm, 1 north, 2 east, 3 south, 4 west (WindMsgTbl order). EXODUS reads it too.
WindDir label byte
	db 0h	;@1F42
; RandState: a 128-bit number, RandState+0 its most significant byte (Random). ULTIMA (5D18) and
; EXODUS (2554) seed its eight words with the DOS date (int 21h AH=2Ah: CX year, DH month, DL day)
; and time (AH=2Ch: CH hour, CL minute, DH second, DL hundredths): +0 year, +2 month/day, +4
; hour/minute, +6 second/hundredths, and the same again from +8. BOOTUP leaves it at zero.
RandState label byte
	db 0h,0h	;@1F43
RandMonthDay label byte
	db 0h,0h	;@1F45
RandHourMin label byte
	db 0h,0h	;@1F47
RandSecHund label byte
	db 0h,0h	;@1F49
RandYear2 label byte
	db 0h,0h	;@1F4B
RandMonthDay2 label byte
	db 0h,0h	;@1F4D
RandHourMin2 label byte
	db 0h,0h	;@1F4F
RandSecHund2 label byte
	db 0h,0h	;@1F51
; Animation counters: calls of AnimScroll / AnimFlags until each tile moves again, and their reload values.
WaterCount label byte
	db 3h	;@1F53
LavaCount label byte
	db 2h	;@1F54
FieldCount label byte
	db 3h	;@1F55
GateCount label byte
	db 2h	;@1F56
CastleFlagCount label byte
	db 4h	;@1F57
TowneFlagCount label byte
	db 3h	;@1F58
ShipFlagCount label byte
	db 2h	;@1F59
; WindCount: calls of WindUpdate until the wind may change (reloaded with 25).
WindCount label byte
	db 1h	; changes at the first call	;@1F5A
; BlinkCount: combat blink of the active member, a signed count towards 0 (BlinkPlayer): 10 calls
; with his tile shown, then -3 .. 0 with the tile under him. ReadKey and COMBAT set 2.
BlinkCount label byte
	db 0Ah	;@1F5B
; FrameCount: calls of SwapFrames until the figures switch to their other frame (10).
FrameCount label byte
	db 0Ah	;@1F5C
; The wind texts printed on the status line (row 17h, column 6) between the glyphs 10h and 11h.
MsgCalmWind label byte
	db 10h,43h,61h,6Ch,6Dh,20h,20h,57h,69h,6Eh,64h,11h,0h	; 10h 'Calm  Wind' 11h	;@1F5D
MsgNorthWind label byte
	db 10h,4Eh,6Fh,72h,74h,68h,20h,57h,69h,6Eh,64h,11h,0h	; 10h 'North Wind' 11h	;@1F6A
MsgSouthWind label byte
	db 10h,53h,6Fh,75h,74h,68h,20h,57h,69h,6Eh,64h,11h,0h	; 10h 'South Wind' 11h	;@1F77
MsgEastWind label byte
	db 10h,45h,61h,73h,74h,20h,20h,57h,69h,6Eh,64h,11h,0h	; 10h 'East  Wind' 11h	;@1F84
MsgWestWind label byte
	db 10h,57h,65h,73h,74h,20h,20h,57h,69h,6Eh,64h,11h,0h	; 10h 'West  Wind' 11h	;@1F91
; The file messages (row 18h), then the program hangs. The file name was meant to follow the
; first two, but OpenFile has changed SI by then: 15 spaces follow instead.
MsgUnableRead label byte
	db 55h,6Eh,61h,62h,6Ch,65h,20h,74h,6Fh,20h,72h,65h,61h,64h,20h,66h	; 'Unable to read file '	;@1F9E
	db 69h,6Ch,65h,20h,0h	;@1FAE
MsgUnableWrite label byte
	db 55h,6Eh,61h,62h,6Ch,65h,20h,74h,6Fh,20h,77h,72h,69h,74h,65h,20h	; 'Unable to write file '	;@1FB3
	db 66h,69h,6Ch,65h,20h,0h	;@1FC3
MsgWrongDiskette label byte
	db 57h,72h,6Fh,6Eh,67h,20h,44h,69h,73h,6Bh,65h,74h,74h,65h,21h,0h	; 'Wrong Diskette!'	;@1FC9
MsgBlankLine label byte
	db 20h,20h,20h,20h,20h,20h,20h,20h,20h,20h,20h,20h,20h,20h,20h,0h	; 15 spaces	;@1FD9
; TileGfx: SHAPES.ULT (1400h bytes, 80 tiles of 64 bytes: the 8 even lines, then the 8 odd ones).
; Split by what SwapFrames swaps: tiles 0-11, 12-15, 16-63, 64-79 (the second frames).
TileGfx label byte
	db 768 dup (0)	; tiles 0-11	;@1FE9
WhirlpoolGfx label byte
	db 256 dup (0)	; tile 12 (whirlpool) - 15	;@22E9
FigureGfx label byte
	db 3072 dup (0)	; tiles 16-63	;@23E9
AltFrameGfx label byte
	db 1024 dup (0)	; tiles 64-79	;@2FE9
; CharGfx: CHARSET.ULT (800h bytes, 128 characters of 16 bytes: 4 even lines, then 4 odd).
CharGfx label byte
	db 4096 dup (0)	;@33E9
ScreenSeg label byte
	db 0h,0B8h	; B800h: the CGA screen	;@43E9
;------------------------------------------------------------------------------
; PrintStrLen: print the NUL-ended string at SI at the cursor (PutChar).
; In: SI. Out: CX = its length. Saves the rest.
;------------------------------------------------------------------------------
PrintStrLen:	pushf	;@43EB
	push ax	;@43EC
	push si	;@43ED
	cld	;@43EE
	mov cx, 0	;@43EF
PrintStrLen_Loop:	lodsb	;@43F2
	cmp al, 0	; NUL ends	;@43F3
	je PrintStrLen_Done	;@43F5
	inc cx	;@43F7
	call PutChar	;@43F8
	jmp PrintStrLen_Loop	;@43FB
PrintStrLen_Done:	pop si	;@43FD
	pop ax	;@43FE
	popf	;@43FF
	ret	;@4400
;------------------------------------------------------------------------------
; PrintStr: print the NUL-ended string at SI at the cursor. Saves all.
;------------------------------------------------------------------------------
PrintStr:	push cx	;@4401
	call PrintStrLen	;@4402
	pop cx	;@4405
	ret	;@4406
;------------------------------------------------------------------------------
; SwapCursor: exchange DX with the cursor (DL = column, DH = row).
;------------------------------------------------------------------------------
SwapCursor:	xchg word ptr CursorCol, dx	;@4407
	ret	;@440B
;------------------------------------------------------------------------------
; PutChar: draw character AL at the cursor and move right; after column 39 to column 0 of the next
; row (no scrolling). 8 = backspace: move left only (to column 39 of the row above), nothing erased.
; Saves all.
;------------------------------------------------------------------------------
PutChar:	push ax	;@440C
	cmp al, 8	; backspace	;@440D
	je PutChar_Back	;@440F
	call DrawChar	;@4411
	inc byte ptr CursorCol	;@4414
	cmp byte ptr CursorCol, 28h	; past column 39:	;@4418
	jne PutChar_Done	;@441D
	inc byte ptr CursorRow	;@441F
	mov byte ptr CursorCol, 0	; to column 0 of the next row	;@4423
PutChar_Done:	pop ax	;@4428
	ret	;@4429
PutChar_Back:	dec byte ptr CursorCol	;@442A
	cmp byte ptr CursorCol, 0FFh	; before column 0:	;@442E
	jne PutChar_Done	;@4433
	mov byte ptr CursorCol, 27h	;@4435
	dec byte ptr CursorRow	;@443A
	jmp PutChar_Done	;@443E
;------------------------------------------------------------------------------
; DrawChar: draw character AL (CharGfx, 8 x 8 pixels) in the cell at the cursor, without moving it.
; The cell is at screen offset row * 320 + column * 2: 4 even lines in bank 0, 4 odd ones in bank 1.
; Saves all.
;------------------------------------------------------------------------------
DrawChar:	pushf	;@4440
	push ax	;@4441
	push bx	;@4442
	push si	;@4443
	push es	;@4444
	cld	;@4445
	mov es, word ptr ScreenSeg	;@4446
	mov ah, 0	; AX = AL * 16	;@444A
	shl ax, 1	;@444C
	shl ax, 1	;@444E
	shl ax, 1	;@4450
	shl ax, 1	;@4452
	mov si, ax	;@4454
	lea si, CharGfx[si]	; SI = its 16 bytes	;@4456
	mov bh, 0	;@445A
	mov bl, byte ptr CursorRow	; BX = row * 64 ...	;@445C
	shl bx, 1	;@4460
	shl bx, 1	;@4462
	shl bx, 1	;@4464
	shl bx, 1	;@4466
	shl bx, 1	;@4468
	shl bx, 1	;@446A
	mov ax, bx	;@446C
	shl bx, 1	;@446E
	shl bx, 1	;@4470
	add bx, ax	; ... * 5 = row * 320	;@4472
	mov ah, 0	;@4474
	mov al, byte ptr CursorCol	;@4476
	shl ax, 1	;@4479
	add bx, ax	; + column * 2	;@447B
	lodsw	;@447D
	mov word ptr es:[bx], ax	; even lines 0, 2, 4, 6 (bank 0, 80 bytes a line)	;@447E
	lodsw	;@4481
	mov word ptr es:[bx+50h], ax	;@4482
	lodsw	;@4486
	mov word ptr es:[bx+0A0h], ax	;@4487
	lodsw	;@448C
	mov word ptr es:[bx+0F0h], ax	;@448D
	lodsw	;@4492
	mov word ptr es:[bx+2000h], ax	; odd lines 1, 3, 5, 7 (bank 1)	;@4493
	lodsw	;@4498
	mov word ptr es:[bx+2050h], ax	;@4499
	lodsw	;@449E
	mov word ptr es:[bx+20A0h], ax	;@449F
	lodsw	;@44A4
	mov word ptr es:[bx+20F0h], ax	;@44A5
	pop es	;@44AA
	pop si	;@44AB
	pop bx	;@44AC
	pop ax	;@44AD
	popf	;@44AE
	ret	;@44AF
;------------------------------------------------------------------------------
; DiskCheckStub: the copy protection, patched out. The routine read track 9, head 0, sectors 16
; down to 1 of the current drive (A: or B:) with int 13h (4 tries each, into C000:0000): a normal
; disk has 8 or 9 sectors a track, so only the original disk's specially formatted track passes.
; Its first 3 bytes (its pushes) are overwritten with `mov al, n` / `ret`: the rest is reached by
; nobody, and still pops what it no longer pushes (the flags, BX, AX; EXODUS: the flags, DS, BX).
; Out: AL = 0 in BOOTUP and ULTIMA. Only ULTIMA calls it (5D8D): it stores AL in its flag at 432C
; and the intro hangs while that is 0FFh, so returning 0 is how the protection is bypassed.
; EXODUS's stub returns 0FFh (nobody calls it there). The original result was AL = 0 when all 16
; sectors read and 0FFh (EXODUS: 1) when one failed. EXODUS's copy is 6 bytes shorter and ends
; with popf, no ret (it would run into FillCell). Written as db because the copies differ:
; the IFDEF must stay as it is. See docs/HANDOFF.md, "The shared library".
;------------------------------------------------------------------------------
DiskCheckStub label near
IFDEF PROG_EXODUS
; EXODUS: mov al, 0FFh / ret, then the check (pushes AX CX DX SI DI BP ES)
	db 0B0h,0FFh,0C3h,50h,51h,52h,56h,57h,55h,6h,0B4h,19h,0CDh,21h,3Ch,1h	;@44B0
	db 76h,2h,0B0h,0h,8Ah,0D0h,0BEh,4h,0h,0B1h,10h,0B8h,1h,2h,0B6h,0h	;@44C0
	db 0B5h,9h,0BBh,0h,0C0h,8Eh,0C3h,33h,0DBh,0CDh,13h,72h,9h,0FEh,0C9h,74h	;@44D0
	db 0Eh,0BEh,4h,0h,0EBh,0E5h,4Eh,74h,2h,0EBh,0E0h,0B3h,1h,0EBh,2h,0B3h	;@44E0
	db 0h,7h,5Dh,5Fh,5Eh,5Ah,59h,58h,8Ah,0C3h,5Bh,1Fh,9Dh	;@44F0
ELSE
; BOOTUP, ULTIMA: mov al, 0 / ret, then the check (pushes CX DX DS ES BP, DI SI)
	db 0B0h,0h,0C3h,51h,52h,1Eh,6h,55h,8Bh,0ECh,57h,56h,0B4h,19h,0CDh,21h	;@44B0
	db 3Ch,1h,76h,2h,0B0h,0h,8Ah,0D0h,0BEh,4h,0h,0B1h,10h,0B8h,1h,2h	;@44C0
	db 0B6h,0h,0B5h,9h,0BBh,0h,0C0h,8Eh,0C3h,33h,0DBh,0CDh,13h,72h,9h,0FEh	;@44D0
	db 0C9h,74h,0Eh,0BEh,4h,0h,0EBh,0E5h,4Eh,75h,0E2h,0BBh,0FFh,0FFh,0EBh,4h	;@44E0
	db 90h,0BBh,0h,0h,5Eh,5Fh,8Bh,0E5h,5Dh,7h,1Fh,5Ah,59h,58h,8Ah,0C3h	;@44F0
	db 5Bh,9Dh,0C3h	;@4500
ENDIF
;------------------------------------------------------------------------------
; FillCell: store AX in the 8 scan lines of the character cell at screen offset BX (a 2-byte wide
; cell: 4 lines in each bank). Saves all.
;------------------------------------------------------------------------------
FillCell:	push ds	;@4503
	mov ds, word ptr ss:ScreenSeg	; DS = the screen (ScreenSeg read through SS)	;@4504
	mov word ptr [bx], ax	;@4509
	mov word ptr [bx+50h], ax	;@450B
	mov word ptr [bx+0A0h], ax	;@450E
	mov word ptr [bx+0F0h], ax	;@4512
	mov word ptr [bx+2000h], ax	;@4516
	mov word ptr [bx+2050h], ax	;@451A
	mov word ptr [bx+20A0h], ax	;@451E
	mov word ptr [bx+20F0h], ax	;@4522
	pop ds	;@4526
	ret	;@4527
;------------------------------------------------------------------------------
; DrawTileBlock: draw AH rows x AL columns of 16 x 16 tiles, tile numbers from the list at BX
; (row by row), graphics at BP (64 bytes a tile: TileGfx), at screen offset DI (top left).
; Saves all.
;------------------------------------------------------------------------------
DrawTileBlock:	pushf	;@4528
	push ax	;@4529
	push bx	;@452A
	push cx	;@452B
	push dx	;@452C
	push si	;@452D
	push di	;@452E
	push es	;@452F
	cld	;@4530
	mov es, word ptr ScreenSeg	;@4531
	mov dh, al	; DH = bytes in a row of tiles (AL * 4)	;@4535
	shl dh, 1	;@4537
	shl dh, 1	;@4539
DrawTileBlock_Row:	mov dl, al	; DL = tiles left in this row	;@453B
DrawTileBlock_Tile:	mov si, word ptr [bx]	; next tile number	;@453D
	inc bx	;@453F
	and si, 0FFh	;@4540
	shl si, 1	;@4544
	shl si, 1	;@4546
	shl si, 1	;@4548
	shl si, 1	;@454A
	shl si, 1	;@454C
	shl si, 1	;@454E
	add si, bp	; SI = BP + tile * 64	;@4550
	mov cx, 8	;@4552
DrawTileBlock_Even:	movsw	; 8 even lines of 4 bytes, 80 apart	;@4555
	movsw	;@4556
	add di, 4Ch	;@4557
	loop DrawTileBlock_Even	;@455A
	add di, 1D80h	; + 280h = 2000h: the same place in bank 1	;@455C
	mov cx, 8	;@4560
DrawTileBlock_Odd:	movsw	; 8 odd lines	;@4563
	movsw	;@4564
	add di, 4Ch	;@4565
	loop DrawTileBlock_Odd	;@4568
	sub di, 227Ch	; back to bank 0, 4 bytes (16 pixels) right	;@456A
	dec dl	;@456E
	jne DrawTileBlock_Tile	;@4570
	add di, 280h	; next row: 16 pixel lines down, back to the left	;@4572
	mov cl, dh	;@4576
	mov ch, 0	;@4578
	sub di, cx	;@457A
	dec ah	;@457C
	jne DrawTileBlock_Row	;@457E
	pop es	;@4580
	pop di	;@4581
	pop si	;@4582
	pop dx	;@4583
	pop cx	;@4584
	pop bx	;@4585
	pop ax	;@4586
	popf	;@4587
	ret	;@4588
;------------------------------------------------------------------------------
; ClearScreen: clear both CGA banks to black and put the cursor at 0. Saves all.
;------------------------------------------------------------------------------
ClearScreen:	pushf	;@4589
	push ax	;@458A
	push cx	;@458B
	push di	;@458C
	push es	;@458D
	mov ax, 0	;@458E
	cld	;@4591
	mov es, word ptr ScreenSeg	;@4592
	mov di, 0	;@4596
	mov cx, 0FA0h	; 8000 bytes of bank 0	;@4599
	rep stosw	;@459C
	mov di, 2000h	;@459E
	mov cx, 0FA0h	; and of bank 1	;@45A1
	rep stosw	;@45A4
	mov word ptr CursorCol, 0	; cursor to column 0, row 0	;@45A6
	pop es	;@45AC
	pop di	;@45AD
	pop cx	;@45AE
	pop ax	;@45AF
	popf	;@45B0
	ret	;@45B1
;------------------------------------------------------------------------------
; IdleNop: a bare ret. ReadKey calls it after every 80 polls of a key (an idle hook left empty).
;------------------------------------------------------------------------------
IdleNop:	ret	;@45B2
;------------------------------------------------------------------------------
; ReadLine: read up to CX printable characters (20h-7Fh) to ES:DI, echoing them; Backspace,
; Ctrl-Backspace and cursor left delete, Enter ends; anything else (or a full buffer) beeps.
; No NUL is stored. In: CX, ES:DI. Out: BX = the number of characters typed. Saves the rest.
;------------------------------------------------------------------------------
ReadLine:	pushf	;@45B3
	push ax	;@45B4
	push cx	;@45B5
	push di	;@45B6
	cld	;@45B7
	mov bx, cx	; BX = room at the start	;@45B8
ReadLine_Key:	call ReadKey	;@45BA
	cmp ax, 0E08h	; Backspace	;@45BD
	je ReadLine_Back	;@45C0
	cmp ax, 0E7Fh	; Ctrl-Backspace	;@45C2
	je ReadLine_Back	;@45C5
	cmp ax, 4B00h	; cursor left	;@45C7
	je ReadLine_Back	;@45CA
	cmp ax, 1C0Dh	; Enter	;@45CC
	je ReadLine_Enter	;@45CF
	cmp al, 20h	; control character	;@45D1
	jb ReadLine_Beep	;@45D3
	cmp al, 80h	; not ASCII	;@45D5
	jae ReadLine_Beep	;@45D7
	jcxz ReadLine_Beep	; buffer full	;@45D9
	stosb	;@45DB
	call PutChar	;@45DC
	dec cx	;@45DF
	jmp ReadLine_Key	;@45E0
ReadLine_Enter:	sub bx, cx	; BX = characters typed	;@45E2
	pop di	;@45E4
	pop cx	;@45E5
	pop ax	;@45E6
	popf	;@45E7
	ret	;@45E8
ReadLine_Back:	cmp bx, cx	; nothing to delete	;@45E9
	je ReadLine_Beep	;@45EB
	mov al, 8	;@45ED
	call PutChar	;@45EF
	inc cx	;@45F2
	dec di	;@45F3
	mov byte ptr es:[di], 20h	; blank it in the buffer too	;@45F4
	jmp ReadLine_Key	;@45F8
ReadLine_Beep:	mov al, 0FEh	; error beep	;@45FA
	call Sound	;@45FC
	jmp ReadLine_Key	;@45FF
;------------------------------------------------------------------------------
; Random: step RandState and return DL = a random number 0 .. DH-1.
; RandState is one 128-bit number (byte 0 the most significant): each byte from 14 down to 0
; gets the next byte and the carry added, then the whole number is incremented. DL = byte 0
; reduced by repeated subtraction of DH (DH = 0 would loop for ever). Saves the rest.
;------------------------------------------------------------------------------
Random:	pushf	;@4601
	push ax	;@4602
	push cx	;@4603
	push si	;@4604
	push di	;@4605
	std	; backwards: from the low end	;@4606
	mov cx, 0Fh	;@4607
	lea si, RandState	;@460A
	add si, cx	;@460E
	mov di, si	;@4610
	dec di	;@4612
	clc	;@4613
Random_Add:	lodsb	;@4614
	adc al, byte ptr [si]	; byte i += byte i+1 + carry (i = 14 .. 0)	;@4615
	stosb	;@4617
	loop Random_Add	;@4618
	mov cx, 10h	; then RandState + 1	;@461A
	lea di, RandState	;@461D
	add di, cx	;@4621
Random_Inc:	dec di	;@4623
	inc byte ptr [di]	;@4624
