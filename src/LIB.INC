	push ax	;@46B0
	push bx	;@46B1
	push di	;@46B2
	dec byte ptr CastleFlagCount	;@46B3
	jne AnimFlags_Towne	;@46B7
	lea bx, TileGfx	;@46B9
	add bx, 1C0h	; tile 7: castle	;@46BD
