;------------------------------------------------------------------------------
; BlinkPlayer: in combat (Location = 80h) blink the member whose turn it is (CombatPlayer): count BlinkCount
; towards 0; when it gets there put the tile under him (CombatUnderTile) into the view buffer for 3 calls,
; then his own tile (CombatPartyTile) for 10. His position: CombatPartyX (x), CombatPartyY (y). Saves all.
;------------------------------------------------------------------------------
BlinkPlayer:	pushf	;@4768
	push ax	;@4769
	push bx	;@476A
	cmp byte ptr Location, 80h	; in combat only	;@476B
	jne BlinkPlayer_Done	;@4770
	mov al, byte ptr BlinkCount	; count BlinkCount towards 0	;@4772
	call SignStep	;@4775
	neg ah	;@4778
	add byte ptr BlinkCount, ah	;@477A
	jne BlinkPlayer_Done	;@477E
	test ah, 0FFh	; was counting down:	;@4780
	jns BlinkPlayer_Show	;@4783
	mov byte ptr BlinkCount, 0FDh	; hide him for 3 calls	;@4785
	mov bl, byte ptr CombatPlayer	; the member whose turn it is	;@478A
	mov bh, 0	;@478E
	mov ah, byte ptr CombatUnderTile[bx]	; the tile under him	;@4790
	mov al, byte ptr CombatPartyY[bx]	; his y	;@4794
	mov bl, byte ptr CombatPartyX[bx]	; his x	;@4798
	mov bh, al	;@479C
	call ViewTileAt	;@479E
	mov byte ptr [bx], ah	; into the view buffer	;@47A1
	jmp short BlinkPlayer_Done	;@47A3
BlinkPlayer_Show:	mov byte ptr BlinkCount, 0Ah	; was counting up: show him for 10	;@47A5
	mov bl, byte ptr CombatPlayer	;@47AA
	mov bh, 0	;@47AE
	mov ah, byte ptr CombatPartyTile[bx]	; his own tile	;@47B0
	mov al, byte ptr CombatPartyY[bx]	;@47B4
	mov bl, byte ptr CombatPartyX[bx]	;@47B8
	mov bh, al	;@47BC
	call ViewTileAt	;@47BE
	mov byte ptr [bx], ah	;@47C1
BlinkPlayer_Done:	pop bx	;@47C3
	pop ax	;@47C4
	popf	;@47C5
	ret	;@47C6
;------------------------------------------------------------------------------
; Animate: the work KeyReady does on every poll (not in a dungeon): the wind (not in combat or a
; shrine), AnimScroll, AnimFlags, BlinkPlayer, SwapFrames, then DrawView. So the animation speed and the wind's
; changes depend on how fast the keyboard is polled (the CPU speed).
;------------------------------------------------------------------------------
Animate:	pushf	;@47C7
	cmp byte ptr Location, 80h	; no wind in combat	;@47C8
	je Animate_NoWind	;@47CD
	cmp byte ptr Location, 4	; or in a shrine	;@47CF
	je Animate_NoWind	;@47D4
	call WindUpdate	;@47D6
Animate_NoWind:	call AnimScroll	;@47D9
	call AnimFlags	;@47DC
	call BlinkPlayer	;@47DF
	call SwapFrames	;@47E2
	call DrawView	;@47E5
	popf	;@47E8
	ret	;@47E9
;------------------------------------------------------------------------------
; KeyReady: ZF clear when a key is waiting (BIOS int 16h AH=1); runs Animate unless Location = 1
; (dungeon; ULTIMA keeps 1 there). Saves all but the flags.
;------------------------------------------------------------------------------
KeyReady:	push ax	;@47EA
	mov ah, 1	; BIOS: key waiting? (ZF = no)	;@47EB
	int 16h	;@47ED
	pushf	;@47EF
	cmp byte ptr Location, 1	; dungeon (and ULTIMA): no animation	;@47F0
	je KeyReady_Done	;@47F5
	call Animate	;@47F7
KeyReady_Done:	popf	;@47FA
	pop ax	;@47FB
	ret	;@47FC
;------------------------------------------------------------------------------
; ReadKey: wait for a key, showing the cursor glyph 1Eh at the cursor (Animate runs meanwhile);
; in combat show the active member's tile again and restart his blink. Out: AH = scan code,
; AL = character (BIOS int 16h AH=0). Saves the rest.
;------------------------------------------------------------------------------
ReadKey:	pushf	;@47FD
	push cx	;@47FE
	push bx	;@47FF
	push ax	;@4800
	call KeyReady	;@4801
	jne ReadKey_Got	;@4804
ReadKey_Cursor:	mov al, 1Eh	; the cursor glyph	;@4806
	call DrawChar	;@4808
	mov cx, 50h	; 80 polls	;@480B
ReadKey_Poll:	call KeyReady	;@480E
	loope ReadKey_Poll	;@4811
	jne ReadKey_Erase	;@4813
	call IdleNop	; then the empty hook, and again	;@4815
	jmp ReadKey_Cursor	;@4818
ReadKey_Erase:	mov al, 20h	; erase the cursor	;@481A
	call DrawChar	;@481C
ReadKey_Got:	cmp byte ptr Location, 80h	; combat: put the active member back	;@481F
	jne ReadKey_Bios	;@4824
	mov bl, byte ptr CombatPlayer	;@4826
	mov bh, 0	;@482A
	lea bx, ViewTiles[bx]	;@482C
	mov ah, byte ptr [bx+0ACh]	;@4830
	mov al, byte ptr [bx+0A4h]	;@4834
	mov bl, byte ptr [bx+0A0h]	;@4838
	mov bh, al	;@483C
	call ViewTileAt	;@483E
	mov byte ptr [bx], ah	;@4841
	call DrawView	;@4843
	mov byte ptr BlinkCount, 2	; and blink again soon	;@4846
ReadKey_Bios:	mov ah, 0	; BIOS: read the key	;@484B
	int 16h	;@484D
	mov cx, ax	;@484F
	pop ax	;@4851
	mov ax, cx	;@4852
	pop bx	;@4854
	pop cx	;@4855
	popf	;@4856
	ret	;@4857
;------------------------------------------------------------------------------
; PrintBcdWord: print AX as four hex digits (four BCD digits), high first.
;------------------------------------------------------------------------------
PrintBcdWord:	xchg al, ah	;@4858
	call PrintBcdByte	;@485A
	xchg al, ah	;@485D
	call PrintBcdByte	;@485F
	ret	;@4862
;------------------------------------------------------------------------------
; PrintBcdByte: print AL as two hex digits (two BCD digits), high first.
;------------------------------------------------------------------------------
PrintBcdByte:	pushf	;@4863
	rol al, 1	;@4864
	rol al, 1	;@4866
	rol al, 1	;@4868
	rol al, 1	;@486A
	call PrintDigit	;@486C
	rol al, 1	;@486F
	rol al, 1	;@4871
	rol al, 1	;@4873
	rol al, 1	;@4875
	call PrintDigit	;@4877
	popf	;@487A
	ret	;@487B
;------------------------------------------------------------------------------
; PrintDigit: print the low nibble of AL as a hex digit 0-9, A-F. Saves all.
;------------------------------------------------------------------------------
PrintDigit:	pushf	;@487C
	push ax	;@487D
	and al, 0Fh	;@487E
	add al, 30h	;@4880
	cmp al, 3Ah	; past 9: A-F	;@4882
	jb PrintDigit_Put	;@4884
	add al, 7	;@4886
PrintDigit_Put:	call PutChar	;@4888
	pop ax	;@488B
	popf	;@488C
	ret	;@488D
;------------------------------------------------------------------------------
; ParseNumber: read a number from the CX characters at SI: leading spaces skipped, then hex digits
; up to the first other character. Out: BX = the digits as hex (= BCD for decimal digits),
; DX = the decimal value, 0FFFFh if a digit A-F came, 0FFFEh if there was no digit at all.
; Saves the rest (SI and CX too).
;------------------------------------------------------------------------------
ParseNumber:	pushf	;@488E
	push ax	;@488F
	push cx	;@4890
	push bp	;@4891
	push si	;@4892
	cld	;@4893
	mov dx, 0FFFEh	; DX = -2: no number	;@4894
ParseNumber_Skip:	jcxz ParseNumber_Done	;@4897
	cmp byte ptr [si], 20h	; skip spaces	;@4899
	jne ParseNumber_First	;@489C
	inc si	;@489E
	dec cx	;@489F
	jne ParseNumber_Skip	;@48A0
	jmp short ParseNumber_Done	;@48A2
ParseNumber_First:	mov al, byte ptr [si]	;@48A4
	cmp al, 30h	; the first character must be a hex digit	;@48A6
	jb ParseNumber_Done	;@48A8
	cmp al, 39h	;@48AA
	jbe ParseNumber_Start	;@48AC
	cmp al, 41h	;@48AE
	jb ParseNumber_Done	;@48B0
	cmp al, 46h	;@48B2
	jbe ParseNumber_Start	;@48B4
	cmp al, 61h	;@48B6
	jb ParseNumber_Done	;@48B8
	cmp al, 66h	;@48BA
	ja ParseNumber_Done	;@48BC
ParseNumber_Start:	mov bx, 0	; BX = hex/BCD value	;@48BE
	mov dx, 0	; DX = decimal value	;@48C1
ParseNumber_Loop:	jcxz ParseNumber_Done	;@48C4
	dec cx	;@48C6
	lodsb	;@48C7
	cmp al, 30h	;@48C8
	jb ParseNumber_Done	;@48CA
	cmp al, 39h	;@48CC
	jbe ParseNumber_Digit	;@48CE
	cmp al, 41h	;@48D0
	jb ParseNumber_Done	;@48D2
	cmp al, 46h	;@48D4
	jbe ParseNumber_Digit	;@48D6
	sub al, 20h	; a-f to A-F	;@48D8
	cmp al, 41h	;@48DA
	jb ParseNumber_Done	;@48DC
	cmp al, 46h	;@48DE
	ja ParseNumber_Done	;@48E0
ParseNumber_Digit:	shl bx, 1	;@48E2
	shl bx, 1	;@48E4
	shl bx, 1	;@48E6
	shl bx, 1	;@48E8
	sub al, 30h	; AL = digit value	;@48EA
	cmp al, 9	;@48EC
	jbe ParseNumber_Add	;@48EE
	sub al, 7	;@48F0
ParseNumber_Add:	or bl, al	;@48F2
	cmp dx, -1	; a hex digit came: only BX goes on	;@48F4
	je ParseNumber_Loop	;@48F7
	cmp al, 9	;@48F9
	ja ParseNumber_Hex	;@48FB
	mov bp, dx	; DX = DX * 10 + digit	;@48FD
	shl dx, 1	;@48FF
	shl dx, 1	;@4901
	add dx, bp	;@4903
	shl dx, 1	;@4905
	mov ah, 0	;@4907
	add dx, ax	;@4909
	jmp ParseNumber_Loop	;@490B
ParseNumber_Hex:	mov dx, 0FFFFh	; DX = -1: not decimal	;@490D
	jmp ParseNumber_Loop	;@4910
ParseNumber_Done:	pop si	;@4912
	pop bp	;@4913
	pop cx	;@4914
	pop ax	;@4915
	popf	;@4916
	ret	;@4917
;------------------------------------------------------------------------------
; AskChoice: menu choice. Read a key (upper-cased) until it is in the list of CX letters at ES:DI,
; print the string of that entry (word table at SI) at the cursor, then wait: Enter accepts,
; Backspace or cursor left erase it and ask again, other keys beep.
; In: CX, DI, SI. Out: AL = the letter chosen (CX = 0: returns at once). Saves the rest.
;------------------------------------------------------------------------------
AskChoice:	pushf	;@4918
	push bx	;@4919
	push cx	;@491A
	push dx	;@491B
	push bp	;@491C
	push si	;@491D
	push di	;@491E
	mov bp, sp	;@491F
	cld	;@4921
	mov bx, si	; BX = the string table	;@4922
	mov dx, word ptr CursorCol	; DX = where the answer is printed	;@4924
	jcxz AskChoice_Done	;@4928
AskChoice_Key:	call ReadKey	;@492A
	cmp al, 0	; no character	;@492D
	je AskChoice_Beep	;@492F
	cmp al, 61h	; lower case to upper	;@4931
	jb AskChoice_Find	;@4933
	cmp al, 7Ah	;@4935
	ja AskChoice_Find	;@4937
	sub al, 20h	;@4939
AskChoice_Find:	mov cx, word ptr [bp+8]	; CX = the number of entries (saved CX)	;@493B
	mov si, cx	;@493E
	mov di, word ptr [bp]	; DI = the letter list (saved DI)	;@4940
	repne scasb	;@4943
	je AskChoice_Show	;@4945
AskChoice_Beep:	mov al, 0FEh	;@4947
	call Sound	;@4949
	jmp AskChoice_Key	;@494C
AskChoice_Show:	sub si, cx	; SI = entry * 2	;@494E
	dec si	;@4950
	shl si, 1	;@4951
	mov si, word ptr [bx+si]	;@4953
	call PrintStrLen	; print it, CX = its length	;@4955
	push ax	;@4958
AskChoice_Confirm:	call ReadKey	;@4959
	cmp ax, 4B00h	; cursor left: undo	;@495C
	je AskChoice_Undo	;@495F
	cmp ax, 0E08h	; Backspace: undo	;@4961
	je AskChoice_Undo	;@4964
	cmp ax, 1C0Dh	; Enter: done, AL = the letter	;@4966
	je AskChoice_Ok	;@4969
	mov al, 0FEh	;@496B
	call Sound	;@496D
	jmp AskChoice_Confirm	;@4970
AskChoice_Ok:	pop ax	;@4972
AskChoice_Done:	pop di	;@4973
	pop si	;@4974
	pop bp	;@4975
	pop dx	;@4976
	pop cx	;@4977
	pop bx	;@4978
	popf	;@4979
	ret	;@497A
AskChoice_Undo:	pop ax	;@497B
	mov word ptr CursorCol, dx	; back to the start,	;@497C
	jcxz AskChoice_Again	;@4980
	mov al, 20h	; blank what was printed	;@4982
AskChoice_Erase:	call PutChar	;@4984
	loop AskChoice_Erase	;@4987
AskChoice_Again:	mov word ptr CursorCol, dx	;@4989
	jmp AskChoice_Key	;@498D
;------------------------------------------------------------------------------
; ReadNumber: read a number of up to two digits at the cursor (blanked first), with ReadLine into a
; buffer on the stack (ES must be SS) and ParseNumber; beep and again until there is a digit.
; Out: AL = the digits as BCD (hex), AH = the decimal value (0FFh if a hex digit was typed).
; Saves the rest.
;------------------------------------------------------------------------------
ReadNumber:	pushf	;@498F
	push bx	;@4990
	push cx	;@4991
	push dx	;@4992
	push bp	;@4993
	push si	;@4994
	push di	;@4995
	sub sp, 2	; a 2-byte buffer on the stack	;@4996
	mov bp, sp	;@4999
	mov dx, word ptr CursorCol	; DX = where the number goes	;@499B
ReadNumber_Retry:	call SwapCursor	;@499F
	mov al, 20h	; blank 2 columns	;@49A2
	call PutChar	;@49A4
	call PutChar	;@49A7
	mov word ptr CursorCol, dx	;@49AA
	mov cx, 2	;@49AE
	lea di, [bp]	; ES:DI = the buffer (ES = SS)	;@49B1
	call ReadLine	;@49B4
	mov ax, dx	; AX = the cursor position	;@49B7
	mov cx, bx	; CX = characters typed	;@49B9
	mov si, di	;@49BB
	call ParseNumber	;@49BD
	cmp dx, -2	; no digit: beep and again	;@49C0
	jne ReadNumber_Done	;@49C3
	mov word ptr CursorCol, ax	;@49C5
	mov dx, ax	;@49C8
	mov al, 0FEh	;@49CA
	call Sound	;@49CC
	jmp ReadNumber_Retry	;@49CF
ReadNumber_Done:	mov al, bl	; AL = BCD value	;@49D1
	mov ah, dl	; AH = decimal value	;@49D3
	add sp, 2	;@49D5
	pop di	;@49D8
	pop si	;@49D9
	pop bp	;@49DA
	pop dx	;@49DB
	pop cx	;@49DC
	pop bx	;@49DD
	popf	;@49DE
	ret	;@49DF
;------------------------------------------------------------------------------
; SaveFile: save: write CX bytes from BX to the file named at DX (NUL-ended), one record of CX bytes
; through the FCB at PSP:5Ch; OpenFile first (the file must exist). On a write error print
; "Unable to write file " at row 18h and hang (the name is meant to follow, but SI = MsgBlankLine).
; In: BX, CX, DX. Saves all.
;------------------------------------------------------------------------------
SaveFile:	pushf	;@49E0
	push ax	;@49E1
	push dx	;@49E2
	push si	;@49E3
	push di	;@49E4
	mov si, dx	;@49E5
	mov dx, bx	;@49E7
	mov ah, 1Ah	; DOS: set the DTA to BX	;@49E9
	int 21h	;@49EB
	lea di, ds:[5Ch]	; DI = the FCB at PSP:5Ch	;@49ED
	mov al, 0	;@49F1
	mov ah, 29h	; DOS: parse the name at SI into it	;@49F3
	push si	;@49F5
	int 21h	;@49F6
	pop si	;@49F8
	call OpenFile	;@49F9
	mov word ptr ds:[68h], 0	; FCB current block = 0	;@49FC
	mov byte ptr ds:[7Ch], 0	; FCB current record = 0	;@4A02
	mov word ptr ds:[6Ah], cx	; FCB record size = CX	;@4A07
	mov dx, di	;@4A0B
	mov ah, 15h	; DOS: sequential write	;@4A0D
	int 21h	;@4A0F
	or al, al	;@4A11
	jne SaveFile_Fail	;@4A13
	mov ah, 10h	; DOS: close	;@4A15
	int 21h	;@4A17
	pop di	;@4A19
	pop si	;@4A1A
	pop dx	;@4A1B
	pop ax	;@4A1C
	popf	;@4A1D
	ret	;@4A1E
SaveFile_Fail:	push si	;@4A1F
	lea si, MsgUnableWrite	;@4A20
	mov dx, 1800h	; row 18h, column 0	;@4A24
	call PrintAt	;@4A27
	pop si	;@4A2A
	call PrintStr	; meant: the name; but OpenFile set SI = MsgBlankLine	;@4A2B
SaveFile_Hang:	jmp SaveFile_Hang	; hang	;@4A2E
;------------------------------------------------------------------------------
; LoadFile: read the file named at DX (NUL-ended) to BX, CX bytes (one record of CX bytes, so a
; shorter file is read whole), through the FCB at PSP:5Ch; OpenFile first. A file whose size's low
; word is 0 gives "Unable to read file " at row 18h and a hang. In: BX, CX, DX. Saves all.
;------------------------------------------------------------------------------
LoadFile:	pushf	;@4A30
	push ax	;@4A31
	push dx	;@4A32
	push si	;@4A33
	push di	;@4A34
	mov si, dx	;@4A35
	mov dx, bx	;@4A37
	mov ah, 1Ah	; DOS: set the DTA to BX	;@4A39
	int 21h	;@4A3B
	lea di, ds:[5Ch]	; DI = the FCB at PSP:5Ch	;@4A3D
	mov al, 0	;@4A41
	mov ah, 29h	; DOS: parse the name at SI into it	;@4A43
	push si	;@4A45
	int 21h	;@4A46
	pop si	;@4A48
	call OpenFile	;@4A49
	cmp word ptr ds:[6Ch], 0	; FCB file size, low word	;@4A4C
	je LoadFile_Fail	;@4A51
	mov word ptr ds:[68h], 0	; FCB current block = 0	;@4A53
	mov byte ptr ds:[7Ch], 0	; FCB current record = 0	;@4A59
	mov word ptr ds:[6Ah], cx	; FCB record size = CX	;@4A5E
	mov dx, di	;@4A62
	mov ah, 14h	; DOS: sequential read	;@4A64
	int 21h	;@4A66
	mov ah, 10h	; DOS: close	;@4A68
	int 21h	;@4A6A
	pop di	;@4A6C
	pop si	;@4A6D
	pop dx	;@4A6E
	pop ax	;@4A6F
	popf	;@4A70
	ret	;@4A71
LoadFile_Fail:	push si	;@4A72
	lea si, MsgUnableRead	;@4A73
	mov dx, 1800h	; row 18h, column 0	;@4A77
	call PrintAt	;@4A7A
	pop si	;@4A7D
	call PrintStr	; meant: the name; but OpenFile set SI = MsgBlankLine	;@4A7E
LoadFile_Hang:	jmp LoadFile_Hang	; hang	;@4A81
;------------------------------------------------------------------------------
; OpenFile: open the FCB at DI (DOS int 21h AH=0Fh); while it fails print "Wrong Diskette!" at
; row 18h, beep and wait for a key, then try again. On success blank that line.
; In: DI = FCB. Saves the cursor and DX; destroys AX, SI.
;------------------------------------------------------------------------------
OpenFile:	push dx	;@4A83
	push word ptr CursorCol	; save the cursor	;@4A84
OpenFile_Try:	mov dx, di	;@4A88
	mov ah, 0Fh	; DOS: open the FCB	;@4A8A
	int 21h	;@4A8C
	cmp al, 0FFh	; not found	;@4A8E
	je OpenFile_Wrong	;@4A90
	lea si, MsgBlankLine	; blank the message line	;@4A92
	mov dx, 1800h	;@4A96
	call PrintAt	;@4A99
	pop word ptr CursorCol	;@4A9C
	pop dx	;@4AA0
	ret	;@4AA1
OpenFile_Wrong:	lea si, MsgWrongDiskette	;@4AA2
	mov word ptr CursorCol, 1800h	; row 18h, column 0	;@4AA6
	call PrintStr	;@4AAC
	mov al, 0FEh	; error beep	;@4AAF
	call Sound	;@4AB1
OpenFile_Wait:	call KeyReady	; wait for a key	;@4AB4
	je OpenFile_Wait	;@4AB7
	call ReadKey	; and drop it	;@4AB9
	jmp OpenFile_Try	;@4ABC
;------------------------------------------------------------------------------
; PrintAt: print the string at SI at row DH, column DL (the cursor stays after the text).
; Saves DX.
;------------------------------------------------------------------------------
PrintAt:	push dx	;@4ABE
	call SwapCursor	;@4ABF
	call PrintStr	;@4AC2
	pop dx	;@4AC5
	ret	;@4AC6
;------------------------------------------------------------------------------
; SignStep: AH = -1, 0 or +1 by the sign of AL (a step towards a target: AL = target - position).
; On Sosaria (Location = 0) the map wraps at 64, so AL is taken as a 6-bit signed number and comes
; back with its top two bits cleared; elsewhere AL is unchanged.
;------------------------------------------------------------------------------
SignStep:	pushf	;@4AC7
	cmp byte ptr Location, 0	; Sosaria: the map wraps at 64,	;@4AC8
	jne SignStep_Sign	;@4ACD
	shl al, 1	; so AL counts as 6-bit signed	;@4ACF
	shl al, 1	;@4AD1
SignStep_Sign:	cbw	; AH = 0 or -1	;@4AD3
	test ax, 0FFFFh	;@4AD4
	js SignStep_Restore	;@4AD7
	je SignStep_Restore	;@4AD9
	inc ah	; positive: AH = +1	;@4ADB
SignStep_Restore:	cmp byte ptr Location, 0	;@4ADD
	jne SignStep_Done	;@4AE2
	shr al, 1	; AL back, top two bits cleared	;@4AE4
	shr al, 1	;@4AE6
SignStep_Done:	popf	;@4AE8
	ret	;@4AE9
;------------------------------------------------------------------------------
; DrawView: draw the 11 x 11 tiles of ViewTiles (TileGfx) in the map window at pixel 8.
; Saves all but the flags.
;------------------------------------------------------------------------------
DrawView:	push ax	;@4AEA
	push bx	;@4AEB
	push bp	;@4AEC
	push di	;@4AED
	mov al, 0Bh	; 11 columns	;@4AEE
	mov ah, 0Bh	; 11 rows	;@4AF0
	lea bx, ViewTiles	;@4AF2
	lea bp, TileGfx	;@4AF6
	mov di, 142h	; row 1 (320) + 2 bytes: pixel 8	;@4AFA
	call DrawTileBlock	;@4AFD
	pop di	;@4B00
	pop bp	;@4B01
	pop bx	;@4B02
	pop ax	;@4B03
	ret	;@4B04
;------------------------------------------------------------------------------
; ViewTileAt: BX = the address in ViewTiles of view row BH, column BL; AL = the tile there.
;------------------------------------------------------------------------------
ViewTileAt:	pushf	;@4B05
	mov al, bh	; BH = BH * 11	;@4B06
	shl bh, 1	;@4B08
	shl bh, 1	;@4B0A
	shl bh, 1	;@4B0C
	add bh, al	;@4B0E
	shl al, 1	;@4B10
	add bh, al	;@4B12
	add bl, bh	;@4B14
	mov bh, 0	;@4B16
	lea bx, ViewTiles[bx]	; BX = its address	;@4B18
	mov al, byte ptr [bx]	;@4B1C
	popf	;@4B1E
	ret	;@4B1F
; WindMsgTbl: the wind texts by WindDir.
WindMsgTbl	dw MsgCalmWind	; 0 calm	;@4B20
	dw MsgNorthWind	; 1 north	;@4B22
	dw MsgEastWind	; 2 east	;@4B24
	dw MsgSouthWind	; 3 south	;@4B26
	dw MsgWestWind	; 4 west	;@4B28
;------------------------------------------------------------------------------
; WindUpdate: count down WindCount; at 0 (every 25 calls) choose a new WindDir (Random 0-8: 0-4 that
; wind, 5-8 one of the four directions other than the current one), then print the wind at row 17h,
; column 6, the cursor kept. Saves all.
;------------------------------------------------------------------------------
WindUpdate:	pushf	;@4B2A
	push ax	;@4B2B
	push dx	;@4B2C
	push si	;@4B2D
	dec byte ptr WindCount	;@4B2E
	jne WindUpdate_Print	;@4B32
	mov byte ptr WindCount, 19h	; 25 calls until the next change	;@4B34
WindUpdate_Pick:	mov dh, 9	; DL = 0-8	;@4B39
	call Random	;@4B3B
	cmp dl, 5	; 0-4: that wind	;@4B3E
	jb WindUpdate_Set	;@4B41
	sub dl, 4	; 5-8: north .. west, but a change	;@4B43
	cmp dl, byte ptr WindDir	;@4B46
	je WindUpdate_Pick	;@4B4A
WindUpdate_Set:	mov byte ptr WindDir, dl	;@4B4C
WindUpdate_Print:	mov dx, 1706h	; row 17h, column 6	;@4B50
	xchg word ptr CursorCol, dx	;@4B53
	mov si, word ptr WindDir	; a word: the high byte masked off	;@4B57
	and si, 0FFh	;@4B5B
	shl si, 1	;@4B5F
	mov si, word ptr WindMsgTbl[si]	;@4B61
	call PrintStr	;@4B65
	mov word ptr CursorCol, dx	;@4B68
	pop si	;@4B6C
	pop dx	;@4B6D
	pop ax	;@4B6E
	popf	;@4B6F
	ret	;@4B70
	db 0h,0h,0h,0h,0h	; zero padding	;@4B71
; Zero padding: 10 more bytes in BOOTUP and ULTIMA, none in EXODUS (its library is shorter
; there); the IFDEF must stay.
IFDEF PROG_EXODUS
ELSE
	db 0h,0h,0h,0h,0h,0h,0h,0h,0h,0h	;@4B76
ENDIF
; SoundOn: 0FFh = sounds play, 0 = silent (EXODUS's sound toggle sets it).
SoundOn label byte
	db 0FFh	; 0 = silent	;@4B80
; SoundTbl: the sound routines for the codes 0FFh down to 0F4h (indexed by NOT code).
SoundTbl	dw SndBuzz	; 0FFh	;@4B81
	dw SndBeep	; 0FEh	;@4B83
	dw SndWarble	; 0FDh	;@4B85
	dw SndNoise	; 0FCh	;@4B87
	dw SndFall	; 0FBh	;@4B89
	dw SndRise	; 0FAh	;@4B8B
	dw SndWarbleE0	; 0F9h	;@4B8D
	dw SndNoiseRise	; 0F8h	;@4B8F
	dw SndHit	; 0F7h	;@4B91
	dw SndTick	; 0F6h	;@4B93
	dw SndTrill	; 0F5h	;@4B95
	dw SndSlowFall	; 0F4h	;@4B97
;------------------------------------------------------------------------------
; Sound: play sound AL (0F4h-0FFh) through SoundTbl if SoundOn; other codes do nothing.
; All sounds toggle the speaker bit of port 61h in timed loops (CPU-speed dependent, no timer).
; The routines may change BX, CX, DX (see each). Saves AX, DI and the flags.
;------------------------------------------------------------------------------
Sound:	pushf	;@4B99
	cmp byte ptr SoundOn, 0	;@4B9A
	je Sound_Done	;@4B9F
	cmp al, 0F4h	; below 0F4h: nothing	;@4BA1
	jb Sound_Done	;@4BA3
	push ax	;@4BA5
	push di	;@4BA6
	not al	; DI = (0FFh - AL) * 2	;@4BA7
	shl al, 1	;@4BA9
	mov di, ax	;@4BAB
	and di, 0FFh	;@4BAD
	call word ptr SoundTbl[di]	;@4BB1
	pop di	;@4BB5
	pop ax	;@4BB6
Sound_Done:	popf	;@4BB7
	ret	;@4BB8
;------------------------------------------------------------------------------
; SndBuzz (0FFh): 16 half-waves with a long delay: a low buzz (?).
;------------------------------------------------------------------------------
SndBuzz:	push bx	;@4BB9
	push cx	;@4BBA
	in al, 61h	; port 61h: the speaker control	;@4BBB
	push ax	;@4BBD
	and al, 0FCh	; timer 2 gate and speaker data off	;@4BBE
	mov cx, 10h	;@4BC0
SndBuzz_Loop:	out 61h, al	;@4BC3
	xor al, 2	; toggle the speaker	;@4BC5
	mov di, 1	;@4BC7
SndBuzz_Delay:	mov bx, 3E8h	; delay (CPU speed)	;@4BCA
SndBuzz_Wait:	dec bx	;@4BCD
	jne SndBuzz_Wait	;@4BCE
	dec di	;@4BD0
	jne SndBuzz_Delay	;@4BD1
	loop SndBuzz_Loop	;@4BD3
	pop ax	;@4BD5
	out 61h, al	;@4BD6
	pop cx	;@4BD8
	pop bx	;@4BD9
	ret	;@4BDA
;------------------------------------------------------------------------------
; SndBeep (0FEh): 48 half-waves at a higher pitch: the error beep of the input routines.
;------------------------------------------------------------------------------
SndBeep:	push bx	;@4BDB
	push cx	;@4BDC
	in al, 61h	;@4BDD
	push ax	;@4BDF
	and al, 0FCh	;@4BE0
	mov cx, 30h	;@4BE2
SndBeep_Loop:	out 61h, al	;@4BE5
	xor al, 2	;@4BE7
	mov di, 1	;@4BE9
SndBeep_Delay:	mov bx, 163h	;@4BEC
SndBeep_Wait:	dec bx	;@4BEF
	jne SndBeep_Wait	;@4BF0
	dec di	;@4BF2
	jne SndBeep_Delay	;@4BF3
	loop SndBeep_Loop	;@4BF5
	pop ax	;@4BF7
	out 61h, al	;@4BF8
	pop cx	;@4BFA
	pop bx	;@4BFB
	ret	;@4BFC
;------------------------------------------------------------------------------
; SndWarble (0FDh): a tone of constant pitch whose duty cycle sweeps out and back: high time CH from
; BL down, low time CL from 1 up to 1Ah, BH waves each step, then back. Called as 0FDh it uses the
; caller's BX (?); SndWarbleE0 sets BL = 0E0h, BH = 4.
;------------------------------------------------------------------------------
SndWarble:	push bx	;@4BFD
	push cx	;@4BFE
	push dx	;@4BFF
	in al, 61h	;@4C00
	push ax	;@4C02
	and al, 0FCh	;@4C03
	mov ch, bl	; CH = high time	;@4C05
	mov cl, 1	; CL = low time	;@4C07
SndWarble_Step:	mov dl, bh	;@4C09
SndWarble_Cycle:	mov dh, ch	;@4C0B
SndWarble_Hi:	dec dh	;@4C0D
	jne SndWarble_Hi	;@4C0F
	out 61h, al	;@4C11
	xor al, 2	;@4C13
	mov dh, cl	;@4C15
SndWarble_Lo:	dec dh	;@4C17
	jne SndWarble_Lo	;@4C19
	out 61h, al	;@4C1B
	xor al, 2	;@4C1D
	dec dl	;@4C1F
	jne SndWarble_Cycle	;@4C21
	dec ch	;@4C23
	inc cl	;@4C25
	cmp cl, 1Bh	;@4C27
	jne SndWarble_Step	; then the same back	;@4C2A
SndWarble_Step2:	mov dl, bh	;@4C2C
SndWarble_Cycle2:	mov dh, ch	;@4C2E
SndWarble_Hi2:	dec dh	;@4C30
	jne SndWarble_Hi2	;@4C32
	out 61h, al	;@4C34
	xor al, 2	;@4C36
	mov dh, cl	;@4C38
SndWarble_Lo2:	dec dh	;@4C3A
	jne SndWarble_Lo2	;@4C3C
	out 61h, al	;@4C3E
	xor al, 2	;@4C40
	dec dl	;@4C42
	jne SndWarble_Cycle2	;@4C44
	dec cl	;@4C46
	inc ch	;@4C48
	cmp cl, 0	;@4C4A
	jne SndWarble_Step2	;@4C4D
	pop ax	;@4C4F
	out 61h, al	;@4C50
	pop dx	;@4C52
	pop cx	;@4C53
	pop bx	;@4C54
	ret	;@4C55
;------------------------------------------------------------------------------
; SndNoise (0FCh): 128 half-waves of random length (Random 0-14 plus the caller's BL (?)).
;------------------------------------------------------------------------------
SndNoise:	push bx	;@4C56
	push cx	;@4C57
	push dx	;@4C58
	in al, 61h	;@4C59
	push ax	;@4C5B
	and al, 0FCh	;@4C5C
	mov bh, 80h	;@4C5E
SndNoise_Loop:	mov dh, 0Fh	;@4C60
	call Random	; DL = 0-14	;@4C62
	adc dl, bl	; + BL (the caller's)	;@4C65
SndNoise_Delay:	mov cx, 3	;@4C67
SndNoise_Wait:	loop SndNoise_Wait	;@4C6A
	dec dl	;@4C6C
	jne SndNoise_Delay	;@4C6E
	out 61h, al	;@4C70
	xor al, 2	;@4C72
	dec bh	;@4C74
	jne SndNoise_Loop	;@4C76
	pop ax	;@4C78
	out 61h, al	;@4C79
	pop dx	;@4C7B
	pop cx	;@4C7C
	pop bx	;@4C7D
	ret	;@4C7E
;------------------------------------------------------------------------------
; SndFall (0FBh): 251 half-waves getting longer: a falling sweep.
;------------------------------------------------------------------------------
SndFall:	push bx	;@4C7F
	in al, 61h	;@4C80
	push ax	;@4C82
	and al, 0FCh	;@4C83
	mov bl, 0FBh	; half-wave length 256 - BL	;@4C85
SndFall_Loop:	out 61h, al	;@4C87
	xor al, 2	;@4C89
	mov bh, bl	;@4C8B
SndFall_Wait:	inc bh	;@4C8D
	jne SndFall_Wait	;@4C8F
	dec bl	;@4C91
	jne SndFall_Loop	;@4C93
	pop ax	;@4C95
	out 61h, al	;@4C96
	pop bx	;@4C98
	ret	;@4C99
;------------------------------------------------------------------------------
; SndRise (0FAh): 160 half-waves getting shorter: a rising sweep.
;------------------------------------------------------------------------------
SndRise:	push bx	;@4C9A
	push cx	;@4C9B
	in al, 61h	;@4C9C
	push ax	;@4C9E
	and al, 0FCh	;@4C9F
	mov bh, 0A0h	; half-wave length BH, 160 down to 1	;@4CA1
	mov ch, 0	;@4CA3
SndRise_Loop:	mov cl, bh	;@4CA5
SndRise_Wait:	dec cx	;@4CA7
	jne SndRise_Wait	;@4CA8
	out 61h, al	;@4CAA
	xor al, 2	;@4CAC
	dec bh	;@4CAE
	jne SndRise_Loop	;@4CB0
	pop ax	;@4CB2
	out 61h, al	;@4CB3
	pop cx	;@4CB5
	pop bx	;@4CB6
	ret	;@4CB7
;------------------------------------------------------------------------------
; SndWarbleE0 (0F9h): SndWarble with BL = 0E0h, BH = 4.
;------------------------------------------------------------------------------
SndWarbleE0:	push bx	;@4CB8
	mov bl, 0E0h	;@4CB9
	mov bh, 4	;@4CBB
	call SndWarble	;@4CBD
	pop bx	;@4CC0
	ret	;@4CC1
;------------------------------------------------------------------------------
; SndNoiseRise (0F8h): 160 half-waves of random length whose floor drops from 0E0h to 40h: noise
; rising in pitch.
;------------------------------------------------------------------------------
SndNoiseRise:	push bx	;@4CC2
	push dx	;@4CC3
	in al, 61h	;@4CC4
	push ax	;@4CC6
	and al, 0FCh	;@4CC7
	mov dh, 0FFh	;@4CC9
	mov bl, 0E0h	;@4CCB
	mov bh, 40h	;@4CCD
SndNoiseRise_Loop:	call Random	;@4CCF
	or dl, bl	; the floor drops from 0E0h to 40h	;@4CD2
SndNoiseRise_Wait:	dec dl	;@4CD4
	jne SndNoiseRise_Wait	;@4CD6
	out 61h, al	;@4CD8
	xor al, 2	;@4CDA
	dec bl	;@4CDC
	cmp bl, bh	;@4CDE
	jne SndNoiseRise_Loop	;@4CE0
	pop ax	;@4CE2
	out 61h, al	;@4CE3
	pop dx	;@4CE5
	pop bx	;@4CE6
	ret	;@4CE7
;------------------------------------------------------------------------------
; SndHit (0F7h): 255 half-waves of random length: a burst of noise (hits, damage).
;------------------------------------------------------------------------------
SndHit:	push bx	;@4CE8
	mov bh, 0	;@4CE9
	mov bl, 0FFh	;@4CEB
	call NoiseBurst	;@4CED
	pop bx	;@4CF0
	ret	;@4CF1
;------------------------------------------------------------------------------
; SndTick (0F6h): 8 half-waves of random length: a short tick.
;------------------------------------------------------------------------------
SndTick:	push bx	;@4CF2
	mov bh, 0	;@4CF3
	mov bl, 8	;@4CF5
	call NoiseBurst	;@4CF7
	pop bx	;@4CFA
	ret	;@4CFB
;------------------------------------------------------------------------------
; NoiseBurst: BL half-waves, each Random(0-254) OR BH long. Saves BX and DX; DI changed.
;------------------------------------------------------------------------------
NoiseBurst:	mov di, bx	;@4CFC
	push dx	;@4CFE
	in al, 61h	;@4CFF
	push ax	;@4D01
	and al, 0FCh	;@4D02
	mov dh, 0FFh	;@4D04
NoiseBurst_Loop:	call Random	;@4D06
	or dl, bh	;@4D09
NoiseBurst_Wait:	dec dl	;@4D0B
	jne NoiseBurst_Wait	;@4D0D
	out 61h, al	;@4D0F
	xor al, 2	;@4D11
	dec bl	;@4D13
	jne NoiseBurst_Loop	;@4D15
	pop ax	;@4D17
	out 61h, al	;@4D18
	pop dx	;@4D1A
	mov bx, di	;@4D1B
	ret	;@4D1D
;------------------------------------------------------------------------------
; SndTrill (0F5h): 8 + 2 * (DL AND 0Fh) notes (DL from the caller) of random pitch, 40 half-waves
; each.
;------------------------------------------------------------------------------
SndTrill:	push cx	;@4D1E
	push dx	;@4D1F
	in al, 61h	;@4D20
	push ax	;@4D22
	and al, 0FCh	;@4D23
	and dl, 0Fh	; DL from the caller: 8-38 notes	;@4D25
	shl dl, 1	;@4D28
	add dl, 8	;@4D2A
	mov cl, dl	;@4D2D
SndTrill_Burst:	mov dh, 0FFh	;@4D2F
	call Random	; DL = the note's length	;@4D31
	mov ch, 28h	; 40 half-waves a note	;@4D34
SndTrill_Loop:	mov dh, dl	;@4D36
SndTrill_Wait:	dec dh	;@4D38
	jne SndTrill_Wait	;@4D3A
	out 61h, al	;@4D3C
	xor al, 2	;@4D3E
	dec ch	;@4D40
	jne SndTrill_Loop	;@4D42
	dec cl	;@4D44
	jne SndTrill_Burst	;@4D46
	pop ax	;@4D48
	out 61h, al	;@4D49
	pop dx	;@4D4B
	pop cx	;@4D4C
	ret	;@4D4D
;------------------------------------------------------------------------------
; SndSlowFall (0F4h): 128 steps of 30 half-waves with the length growing from 40h to 0BFh: a slow
; falling sweep.
;------------------------------------------------------------------------------
SndSlowFall:	push bx	;@4D4E
	push cx	;@4D4F
	in al, 61h	;@4D50
	push ax	;@4D52
	and al, 0FCh	;@4D53
	mov bl, 40h	; half-wave length 40h .. 0BFh	;@4D55
SndSlowFall_Step:	mov bh, 1Eh	; 30 half-waves each	;@4D57
SndSlowFall_Loop:	mov cl, bl	;@4D59
