	add bx, 180h	; tile 6: towne	;@46E2
	mov ax, word ptr [bx+24h]	; pixel line 3	;@46E6
	mov di, word ptr [bx+26h]	;@46E9
	xchg word ptr [bx+8], ax	; swapped with pixel line 4	;@46EC
	xchg word ptr [bx+0Ah], di	;@46EF
	mov word ptr [bx+24h], ax	;@46F2
	mov word ptr [bx+26h], di	;@46F5
