AnimFlags_Done:	pop di	;@4722
	pop bx	;@4723
	pop ax	;@4724
	popf	;@4725
	ret	;@4726
;------------------------------------------------------------------------------
; SwapFrames: every 10th call swap the figures with their second frames: tiles 16-30 (merchant .. balron)
; with 64-78 and the whirlpool (12) with 79. So SHAPES.ULT's tiles 64-79 are the figures' second
; frames. Saves all but the flags.
;------------------------------------------------------------------------------
SwapFrames:	push ax	;@4727
	push cx	;@4728
	push si	;@4729
	push di	;@472A
	push es	;@472B
	dec byte ptr FrameCount	;@472C
	jne SwapFrames_Done	;@4730
	mov byte ptr FrameCount, 0Ah	;@4732
	cld	;@4737
	mov ax, ds	;@4738
	mov es, ax	;@473A
	lea si, AltFrameGfx	;@473C
