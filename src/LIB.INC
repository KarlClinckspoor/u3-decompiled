	mov di, word ptr [bx+22h]	;@46C4
	xchg word ptr [bx+4], ax	; swapped with even line 1 (pixel line 2)	;@46C7
	xchg word ptr [bx+6], di	;@46CA
	mov word ptr [bx+20h], ax	;@46CD
	mov word ptr [bx+22h], di	;@46D0
